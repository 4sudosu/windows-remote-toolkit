<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_glass"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_bar_glass"
        android:title="@string/live_title"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
        app:titleTextColor="?attr/colorOnSurface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:text="@string/stop_stream"
            android:textSize="13sp"
            app:icon="@drawable/ic_video" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRotateView"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:text="@string/rotate_view"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFitFill"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:text="@string/fill"
            android:textSize="12sp" />
    </com.google.android.material.appbar.MaterialToolbar>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/live_connecting"
        android:textColor="@color/offline_gray"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="12dp"
        android:background="@android:color/black">

        <ImageView
            android:id="@+id/liveImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/live_title"
            android:scaleType="matrix" />
    </FrameLayout>

    <TextView
        android:id="@+id/zoomLevelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/zoom_level"
        android:textColor="@color/offline_gray"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/live_connected"
        android:textColor="@color/offline_gray"
        android:textSize="12sp" />
</LinearLayout>