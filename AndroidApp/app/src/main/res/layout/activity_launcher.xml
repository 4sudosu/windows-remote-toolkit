<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp"
        android:gravity="center_horizontal">

        <!-- Logo in a raised glass tile -->
        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginTop="56dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_logo_tile" />

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_foreground" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/launcher_title"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/launcher_subtitle"
            android:textSize="15sp"
            android:textColor="@color/offline_gray" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_status_pill"
            android:text="@string/launcher_status_none"
            android:textSize="13sp"
            android:textColor="@color/on_surface" />

        <Button
            android:id="@+id/btnOpenServer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_btn_bordered"
            android:letterSpacing="0.01"
            android:text="@string/open_server"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_primary"
            android:letterSpacing="0.01"
            android:text="@string/launcher_connect"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/launcher_connect_desc"
            android:textSize="12sp"
            android:textColor="#64748B" />

        <Button
            android:id="@+id/btnLocalServer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_bordered"
            android:letterSpacing="0.01"
            android:text="@string/local_server"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvServerState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/on_surface"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnRunServer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_bordered"
            android:letterSpacing="0.01"
            android:text="@string/run_server_all_interfaces"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
