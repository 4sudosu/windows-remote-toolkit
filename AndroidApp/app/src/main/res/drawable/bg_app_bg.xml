<?xml version="1.0" encoding="utf-8"?>
<!-- Layered app background: deep navy base with two soft ambient glows
     (iOS-style elevated dark material). Used as the theme windowBackground. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
        </shape>
    </item>
    <!-- Top glow, behind the app bar -->
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#14084FF6"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Bottom lift -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#0D0A84FF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
