<?xml version="1.0" encoding="utf-8"?>
<!-- Apple-style forward push: the new screen rises softly into place. No overshoot — critically damped (WWDC, Designing Fluid Interfaces). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="280"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <translate
        android:fromYDelta="5%"
        android:toYDelta="0" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />
</set>
