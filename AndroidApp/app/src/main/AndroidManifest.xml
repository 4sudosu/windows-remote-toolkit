<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.RuntimeBroker">

        <activity
            android:name=".LauncherActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity-alias
            android:name=".launcher.Default"
            android:targetActivity=".LauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_default"
            android:roundIcon="@mipmap/ic_launcher_default">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.Emerald"
            android:targetActivity=".LauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_emerald"
            android:roundIcon="@mipmap/ic_launcher_emerald">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.Violet"
            android:targetActivity=".LauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_violet"
            android:roundIcon="@mipmap/ic_launcher_violet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.Rose"
            android:targetActivity=".LauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_rose"
            android:roundIcon="@mipmap/ic_launcher_rose">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.Amber"
            android:targetActivity=".LauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_amber"
            android:roundIcon="@mipmap/ic_launcher_amber">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.Ocean"
            android:targetActivity=".LauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_ocean"
            android:roundIcon="@mipmap/ic_launcher_ocean">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".DeviceActionsActivity"
            android:exported="false" />

        <activity
            android:name=".CaptureActivity"
            android:exported="false"
            android:label="@string/capture_title" />

        <activity
            android:name=".ShellActivity"
            android:exported="false"
            android:label="@string/shell_title" />

        <activity
            android:name=".InputTextActivity"
            android:exported="false"
            android:label="@string/input_text_title" />

        <activity
            android:name=".LiveScreenActivity"
            android:exported="false"
            android:label="@string/live_title" />

        <activity
            android:name=".ScreenControlActivity"
            android:exported="false"
            android:label="@string/screen_control_title" />

        <activity
            android:name=".InputParagraphActivity"
            android:exported="false"
            android:label="@string/paragraph_title" />

        <activity
            android:name=".FileManagerActivity"
            android:exported="false"
            android:label="@string/files_title" />

        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:label="@string/camera_title" />

        <activity
            android:name=".MicActivity"
            android:exported="false"
            android:label="@string/mic_title" />

        <activity
            android:name=".ProcessesActivity"
            android:exported="false"
            android:label="@string/processes_title" />

        <activity
            android:name=".ServicesActivity"
            android:exported="false"
            android:label="@string/services_title" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".ConnectActivity"
            android:exported="false"
            android:label="@string/connect_title" />

        <activity
            android:name=".PlayAudioActivity"
            android:exported="false"
            android:label="@string/play_audio_title" />

        <activity
            android:name=".TransferFilesActivity"
            android:exported="false"
            android:label="@string/transfer_files_title" />

        <activity
            android:name=".InstallAppActivity"
            android:exported="false"
            android:label="@string/install_app_title" />

        <activity
            android:name=".RunAppActivity"
            android:exported="false"
            android:label="@string/run_app_title" />

        <service
            android:name=".NodeServerService"
            android:exported="false"
            android:process=":nodeserver"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>